project:
  name: Episense
  location: Campo Grande, MS
  geocode: '5002704'
  disease: dengue
  target_variable: casos
  se_format: YYYYWW
paths:
  data_raw: data/raw
  data_processed: data/processed
  models: models
  logs: logs
  api: api
data_sources:
  infodengue:
    base_url: https://info.dengue.mat.br/api/alertcity
    geocode: '5002704'
    disease: dengue
    format: csv
    ew_format: SE
  openmeteo:
    base_url: https://archive-api.open-meteo.com/v1/archive
    latitude: -20.4697
    longitude: -54.6201
    timezone: America/Campo_Grande
    daily_variables:
    - temperature_2m_max
    - temperature_2m_min
    - temperature_2m_mean
    - precipitation_sum
    - relative_humidity_2m_mean
    - wind_speed_10m_max
features:
  target_transform: log1p
  legacy_convention:
    log_lag1_shift: 0
    log_lagn_shift: 1
    temp_lag2_shift: 1
    temp_lag4_shift: 3
    p_rt1_rt_nivel_lag1_shift: 2  # Changed from 0 to 2: Rt/p_rt/nivel are nowcasted and revised; use proper lag
  advanced_convention:
    log_lag1_shift: 1
    log_lagn_shift: 1
  lags:
    cases:
    - 1
    - 2
    - 3
    - 4
    - 5
    - 6
    - 7
    - 8
    temperature:
    - 1
    - 2
    - 3
    - 4
    - 5
    - 6
    - 7
    precipitation:
    - 1
    - 2
    - 3
    - 4
    - 5
    - 6
    - 7
    humidity:
    - 1
    - 2
    - 3
    - 4
    - 5
    - 6
    - 7
  rolling_windows:
  - 3
  - 4
  - 8
  - 12
  seasonal_features: true
  interaction_features: true
  horizon_features: true
  # Experimental feature expansions (from train_exp.py / LGBM_swl experiment)
  expand_seasonal: true    # T-52/53 lag, YoY, YTD, YTD ratios (attacks h5-h8 degradation)
  expand_weather_long: true  # Weather lags 7-12, precip accumulations 16-26 weeks (climate long memory)
  expand_extra: false       # Deactivated (increases features but marginal gain) - seasonal+weather_long tested better
  # v2 - novas familias para atacar h5-h8 (WMAPE 0.47-> melhora, rWIS, SPL)
  expand_climatology: true  # media 3y (52/104/156) + anomalias vs climatologia casos/clima
  expand_trend: true        # slopes 4/8/12, momentum, CV, range, accel, growth rates
  expand_outbreak: true     # semanas acima limiar, weeks_since_peak, intensidade, flags fase
  # v3 - correcoes timing e phantom
  expand_regime_conditional: true  # lag52/53 condicional a regime (prev_year outbreak flag) + gating - corrige phantom S52
  expand_peak_timing: true  # distancia ao pico tipico, lag sazonal x slope gating - corrige S6 vs S15
targets:
  horizons:
  - 1
  - 2
  - 3
  - 4
  - 5
  - 6
  - 7
  - 8
  target_cols:
  - target_h1
  - target_h2
  - target_h3
  - target_h4
  target_transform: log1p
model:
  type: LightGBM
  ensemble:
    n_seeds: 5
    seeds:
    - 42
    - 123
    - 456
    - 789
    - 999
    aggregation: mean
  hyperparameters:
    objective: tweedie
    tweedie_variance_power: 1.5
    metric: rmse
    boosting_type: gbdt
    num_leaves: 127
    max_depth: 10
    learning_rate: 0.03
    n_estimators: 3000
    subsample: 0.85
    colsample_bytree: 0.85
    reg_alpha: 0.05
    reg_lambda: 0.05
    min_child_samples: 15
    random_state: 42
    verbosity: -1
    early_stopping_rounds: 150
    feature_fraction: 0.85
    bagging_fraction: 0.85
    bagging_freq: 3
    min_gain_to_split: 0.01
training:
  start_year: 2014  # VENCEDOR do experimento 2011 vs 2014 (6 folds, janelas identicas):
                     # 2011-2013 (outlier 2013 = 45k casos) pioram WMAPE/RMSSE em todos os
                     # horizontes e dobram RMSE em anos recentes de baixa (2020 h1, 2024 h8).
                     # Features usam o histórico completo; só as LINHAS de treino < 2014 saem.
  walk_forward:
    n_splits: 4  # um fold por test_year (2022-2025; 2021 removido)
    test_size_weeks: 52
    gap_weeks: 8  # == max horizon (h8). Seguro: train_end = test_start - gap, ultimo alvo treino = train_end-1+h = test_start-1 < test_start (sem leakage). gap==h maximiza dados sem vazar.
    expanding_window: true
    min_train_weeks: 100  # fold 2022: ~410 semanas de treino (2014-2021, gap 8)
    test_years: [2022, 2023, 2024, 2025]  # Explicit test years for each fold; fold 2025 é parcial (49 sem até 202632, dados atuais) - média 4 folds inclui parcial, ver dashboard nota
    # Validação epidemiológica: folds iniciam em setembro (SE ~35-36) e terminam em agosto
    # Isso garante que cada fold capture o ciclo completo de calmaria (jun-set) + surto (out-maio)
    epidemiological_folds: true
    fold_start_month: 9  # setembro
    fold_end_month: 8    # agosto
    # NOTA: 2017-2020 fora dos folds de teste (regime atual); 2019 permanece no
    # TREINO (modelo aprende o surto gigante) e vira stress-test documentado.
  validation:
    gap_weeks: 4
    expanding: true
  feature_selection:
    method: importance
    threshold: 0.001
    max_features: 380  # v3: SEPARATE por quantil (380 cada) corrige q05 flat; union dilui sinal da cauda
    per_quantile: true  # true=uniao por quantil (legacy); separate_quantile_features sobrepoe
    separate_quantile_features: true  # v3 ATIVADO: cada tau tem seu top 380 (q05/q50/q95 independentes), sem leakage so X_tr - corrige q05 flat h2-h8
    expand_extra: false  # LGBM_swl uses seasonal+weather_long, not full expand_extra
    # threshold por quantil (v3): q05 tem gain menor, usa threshold menor para nao filtrar tudo
    threshold_per_quantile:
      0.05: 0.0005
      0.5: 0.001
      0.95: 0.001
  # v3 correcoes de regime: weighting temporal + peak + gap por horizonte
  temporal_weighting:
    enabled: true       # REATIVADO v3.2 com decay 0.90 (half 6.58y) + early stopping com sample_weight (antes mismatch causou colapso)
    half_life_years: 6.58  # decay 0.90/ano = 0.5^(1/6.58)=0.90 - antes 3y (0.79) era agressivo demais
  peak_weighting:
    enabled: true
    weight_200: 1.3     # y>200 casos => +30% peso (surto moderado)
    weight_500: 1.8     # y>500 => +80% (surto grande)
    weight_1000: 2.2    # y>1000 => +120% (surto extremo) - corrige subestimacao mediana Fold0
  gap_per_horizon: true  # gap = h (nao 8 fixo) => h1 retém 7 semanas recentes perdidas antes
  # FASE1 paralelização por horizonte (8 workers, 4x speedup, 0.0 diff)
  parallel_horizons:
    enabled: true
    n_jobs: 8
    backend: loky  # joblib backend: loky (processos) ou threading (não usar, GIL)
    # cada worker usa 1 thread LightGBM para evitar oversubscription (8 workers *1 =8 cores)
    worker_threads: 1
  # Hyperparams por quantil (v3.1): q05 precisa mais sensibilidade
  quantile_hparams:
    0.05:
      min_gain_to_split: 0.0
      min_child_samples: 10
      reg_alpha: 0.02
      reg_lambda: 0.02
    0.5: {}
    0.95:
      min_gain_to_split: 0.005
      min_child_samples: 12
  scaler:
    type: DataFrameScaler
    feature_range:
    - 0
    - 1

# Quantile regression settings
quantiles:
  - 0.05   # piso IC 90% inferior
  - 0.50   # mediana (previsão pontual robusta)
  - 0.95   # teto IC 90% superior

# Non-crossing quantile constraint
non_crossing:
  enabled: true
  method: "post_process"  # "post_process" ou "monotone_constraints"

# v3 phantom gating para q95 em calmaria (corrige superestimacao 5x em calma)
phantom_gating:
  enabled: true
  # se futura semana for calm (jun-set) e q95 > median * factor, clamp
  calm_q95_max_factor: 3.5  # mediana *3.5 em calm (q95 calm treino p95 315 vs med 60 ~5.2x -> clamp 3.5x)
  outbreak_q95_max_factor: 4.0  # em outbreak mediana*4.0 ainda permite pico 2x mas corta 1500 absurdo
  # usa regime inferido da data futura (mes) igual recal

# Asymmetric loss for horizons 5-8 (penalize undershooting more) - CUSTOM GRADIENT
# undershoot = y_true > y_pred (subestimacao) penalizada 2x para corrigir WIS_under 8-15x
# Implementado via objetivo custom em train.py (per-sample, nao constante sample_weight)
# v3.3: DESATIVADO (mesmo com validacao pesada, 1.35 ainda colapsa h5-h8 0.85) - peso temporal 0.90 já corrige sem assimetria
asymmetric_loss:
  enabled: false  # v3.3 DESATIVADO: 1.35 colapsa h5 0.85 mesmo com validacao pesada
  horizon_threshold: 5  # aplicar para h >= 5
  undershoot_weight: 1.35  # penalizar subestimação 1.35x mais (custom grad) - tune 2.0->1.35 evita colapso
  overshoot_weight: 1.0   # penalização padrão para sobreestimação
  # aplica só mediana por padrão; q05/q95 têm assimetria natural do quantil
  only_median: true

# Epidemiological period classification for stratified reporting
epidemiological_periods:
  outbreak_months: [10, 11, 12, 1, 2, 3, 4, 5]      # Outubro a Maio
  calm_months: [6, 7, 8, 9]                           # Junho a Setembro
  # Usado para stratificar métricas no relatório final
inference:
  horizon_specific_features: true
  feature_alignment: strict
  scaler_path: models/scaler.pkl
  # Padrão real produzido pelo treino multi-quantil: um .pkl por seed e quantil
  # models/lgbm_h{horizon}_seed{seed}_q{tau:04d}.pkl (ex: lgbm_h1_seed42_q0050.pkl)
  # A inferência deriva o nome automaticamente e NÃO usa este bloco (mantido para documentação)
  # Inclui h1-h8 (todos os horizontes treinados)
  model_paths:
    h1: models/lgbm_h1_seed{seed}_q{tau}.pkl

# Episense environment (copy to .env and replace the secrets)
#
# ENVIRONMENT=production makes both services refuse to start without a strong
# EPISENSE_API_KEY. Use ENVIRONMENT=development only locally.
ENVIRONMENT=production

# Expose Swagger/OpenAPI in production (true/false). API routes remain
# token-protected; only the docs page/schema become public.
EPISENSE_ENABLE_DOCS=false

# API token (X-API-Key or Authorization: Bearer). The dashboard asks for this
# same token in its UI; there is no separate username/password.
# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
EPISENSE_API_KEY=replace-with-a-64-character-random-secret

# Exact CORS origins, comma-separated. Wildcards are rejected.
# Leave empty to disable CORS (same-origin only).
EPISENSE_CORS_ORIGINS=

# Per-IP request limit (0 disables). Applied per process.
EPISENSE_RATE_LIMIT_PER_MINUTE=120

# Only these proxy networks may supply X-Forwarded-For / X-Real-IP.
# Leave empty unless a real reverse proxy sits in front of the containers.
TRUSTED_PROXY_CIDR=

# Base URL used by external clients/docs (not consumed by the API itself).
EPISENSE_API_URL=http://localhost:8001
